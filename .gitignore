# Unity generated files
**/Library/
**/Temp/
**/Obj/
**/Build/
**/Builds/
**/MemoryCaptures/
**/Logs/

# User-specific files
**/*.userprefs
**/*.user
**/*.suo
**/*.userosscache
**/*.sln.docstates

# Visual Studio
**/.vs/
**/*.vcxproj.user
**/*.VC.db
**/*.pdb
**/*.opendb

# Autogenerated by Unity
**/*.pidb
**/*.booproj
**/*.svd
**/*.unityproj

# OS files
**/.DS_Store
**/Thumbs.db

# Build output
**/*.apk
**/*.aab
**/*.unitypackage

# Package manager
**/Packages/packages-lock.json

# Rider
**/.idea/
**/*.sln.iml

# MonoDevelop
**/.cache/

# Gradle
**/.gradle/

# Node modules
**/node_modules/

# Logs
**/*.log

# Temporary files
**/*.tmp
**/*.temp

# Generated by Visual Studio for Mac
**/*.pidb.meta

# Ignore compiled assemblies
**/*.dll
**/*.exe
**/*.so
**/*.dylib

# Ignore object and binary directories inside Assets (if present)
**/Assets/**/bin/
**/Assets/**/obj/

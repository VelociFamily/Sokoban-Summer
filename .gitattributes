# Ensure text files use normalized LF in the repo and CRLF on Windows working copies
*.cs    text diff=csharp
*.shader text
*.cginc text
*.txt   text
*.md    text
*.json  text
*.asmdef text
# Unity scene and prefab YAMLs
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset  text merge=unityyamlmerge eol=lf
# Binary assets - recommended to track with Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.zip  binary
# Note: We rely on extension-based rules above so assets are tracked regardless of folder.
# Any previous path-anchored rules for "Sokoban Summer/" were removed after moving the project to repo root.
# Optional: Keep explicit tracking for sound assets if you prefer redundancy
Assets/Sounds/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
